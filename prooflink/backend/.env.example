DATABASE_URL=postgresql+psycopg://prooflink:prooflink@localhost:5432/prooflink
JWT_SECRET=change-me-generate-a-long-random-string
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000

# --- AI review (optional) ---------------------------------------------------
# Without a key the app still works, using the built-in rules only.
LLM_PROVIDER=none
# Claude:
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=your-key-here
#   LLM_MODEL=claude-haiku-4-5-20251001      (optional, this is the default)
# Groq, Grok, OpenAI or any OpenAI-compatible service:
#   LLM_PROVIDER=openai_compatible           (not "groq": only anthropic / openai_compatible are recognised)
#   LLM_API_KEY=your-key-here
#   LLM_BASE_URL=https://api.groq.com/openai/v1   (Grok: https://api.x.ai/v1)
#   LLM_MODEL=openai/gpt-oss-20b             (list yours: curl https://api.groq.com/openai/v1/models)
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20

# Cost / abuse protection, per signed-in user
RATE_LIMIT_PER_MINUTE=10
DAILY_CHECK_LIMIT=100
